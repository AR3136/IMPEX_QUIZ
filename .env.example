# =========================================================================
# IMTEX Exhibition Quiz - Server-Side Environment Variables (Vercel & Local)
# =========================================================================

# 1. Google Sheets API v4 via Service Account (Official Authentication)
# Email address of the Google Cloud Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=imtex-quiz-bot@your-gcp-project.iam.gserviceaccount.com

# Private Key from the Service Account JSON key file (include BEGIN/END tags)
# In Vercel, paste the exact key with \n line breaks.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# The Google Spreadsheet ID from your Sheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=1A2B3C4D5E6F7G8H9I0J_your_sheet_id_here

# Tab name inside the spreadsheet (defaults to 'Responses')
GOOGLE_SHEET_TAB_NAME=Responses

# 2. Exhibition Booth Details
EXHIBITION_NAME="IMTEX 2026/2027"
BOOTH_NUMBER="Hall 4 - Booth A161"

# 3. Staff Portal Security Key (Required for /staff goodies collection)
STAFF_ACCESS_KEY=IMTEX2026_BOOTH_STAFF_SECRET
